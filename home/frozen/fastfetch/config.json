{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "height": 10,
    "width": 1,
    "padding": {
      "top": 4,
      "left": 2
    },
    "color": {
      "1": "white"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[37m┌──────┐"
    },
    {
      "type": "host",
      "key": "\u001b[90m│ \u001b[32m PC\u001b[90m │",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "\u001b[90m│ \u001b[32m  ├\u001b[90m │",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "\u001b[90m│ \u001b[32m  ├\u001b[90m │",
      "format": "{name} {type} {frequency}"
    },
    {
      "type": "memory",
      "key": "\u001b[90m│ \u001b[32m  ├\u001b[90m │"
    },
    {
      "type": "disk",
      "key": "\u001b[90m│ \u001b[32m  ├\u001b[90m │"
    },
    {
      "type": "display",
      "key": "\u001b[90m│ \u001b[32m  ├󰍺\u001b[90m │"
    },
    {
      "type": "battery",
      "key": "\u001b[90m│ \u001b[32m  └󱧥\u001b[90m │"
    },
    {
      "type": "custom",
      "format": "\u001b[37m├──────┤"
    },
    {
      "type": "os",
      "key": "\u001b[90m│ \u001b[33m OS\u001b[90m │",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "\u001b[90m│ \u001b[33m  ├\u001b[90m │"
    },
    {
      "type": "bios",
      "key": "\u001b[90m│ \u001b[33m  ├\u001b[90m │"
    },
    {
      "type": "packages",
      "key": "\u001b[90m│ \u001b[33m  ├󰏖\u001b[90m │"
    },
    {
      "type": "shell",
      "key": "\u001b[90m│ \u001b[33m  └\u001b[90m │"
    },
    {
      "type": "custom",
      "format": "\u001b[37m├──────┤"
    },
    {
      "type": "wm",
      "key": "\u001b[90m│ \u001b[34m WM\u001b[90m │"
    },
    {
      "type": "lm",
      "key": "\u001b[90m│ \u001b[34m  ├󰈂\u001b[90m │"
    },
    {
      "type": "cursor",
      "key": "\u001b[90m│ \u001b[34m  ├󰇀\u001b[90m │"
    },
    {
      "type": "theme",
      "key": "\u001b[90m│ \u001b[34m  ├\u001b[90m │"
    },
    {
      "type": "icons",
      "key": "\u001b[90m│ \u001b[34m  ├󰉼\u001b[90m │"
    },
    {
      "type": "terminal",
      "key": "\u001b[90m│ \u001b[34m  └\u001b[90m │"
    },
    {
      "type": "custom",
      "format": "\u001b[37m├──────┴──────┐"
    },
    {
      "type": "command",
      "key": "\u001b[90m│ \u001b[35m     OS age\u001b[90m │",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "\u001b[90m│ \u001b[35m     Uptime\u001b[90m │"
    },
    {
      "type": "datetime",
      "key": "\u001b[90m│ \u001b[35m   DateTime\u001b[90m │"
    },
    {
      "type": "custom",
      "format": "\u001b[37m└─────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 1,
      "symbol": "circle"
    }
  ]
}
