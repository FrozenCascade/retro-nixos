# Every setting the shell understands, with its default. You do not edit this file: put only the
# values you want to change in settings.nix. Anything missing there comes from here, so a new
# setting added later never breaks an old settings.nix. Lists (keyboardLayouts, workspaceNames)
# are replaced as a whole; tables (apps, power, bar, ...) are merged key by key.
# After changing a value: rebuild. Hyprland and Quickshell read the same merged table.
{
  # ---- screens and workspaces ----
  # Monitor names: `hyprctl monitors`
  externalMonitor = "HDMI-A-1";   # numbered workspaces 1..workspaceCount live here (and the top bar)
  laptopMonitor   = "eDP-1";      # the single laptop workspace lives here
  laptopWorkspace = "laptop";     # name of that workspace (key: `)
  workspaceCount  = 6;            # numbered workspaces on the external monitor (1 to 10)

  # Optional label for the laptop workspace in the shell (null = built-in name)
  laptopName = null;

  # Names shown for the numbered workspaces, in order. glyph: the character, reading: how it is read.
  workspaceNames = [
    { glyph = "一"; reading = "Yī"; }
    { glyph = "二"; reading = "Èr"; }
    { glyph = "三"; reading = "Sān"; }
    { glyph = "四"; reading = "Sì"; }
    { glyph = "五"; reading = "Wǔ"; }
    { glyph = "六"; reading = "Liù"; }
  ];

  # ---- keyboard ----
  # Layouts in the order Hyprland cycles through them (Super+').
  #   code / variant: kb_layout / kb_variant (keep them the same as services.xserver.xkb)
  #   short:          the label in the quick window
  #   name:           what Hyprland reports as the active keymap: hyprctl devices -j | grep active_keymap
  keyboardLayouts = [
    { code = "us"; variant = ""; short = "US"; name = "English (US)"; }
  ];

  # ---- power ----
  # Two steps after a while without keyboard or mouse (home/frozen/idle.nix):
  # lock the screen first, then suspend (unless sound is playing).
  power = {
    lockMinutes = 9;
    suspendMinutes = 10;          # must be larger than lockMinutes
  };

  # ---- top bar ----
  bar = {
    height = 36;                  # pixels
    revealHeight = 4;             # the hover strip at the top edge while the bar is hidden
  };

  # ---- volume and brightness popups ----
  osd = {
    visibleMs = 1400;             # how long they stay on screen
  };

  # ---- which program opens what ----
  defaultApps = {
    fileManager = "org.kde.dolphin.desktop";
  };

  # ---- apps ----
  # How apps look and where they go. The key is the desktop file name without .desktop
  # (`ls /run/current-system/sw/share/applications`, or `flatpak list` for Flatpak apps).
  # Every field is optional; see settings.nix for the full list and examples.
  apps = { };
}
